[Unit]
Description=Run the two Luna closing checks after GPU recovery

[Service]
Type=simple
WorkingDirectory=/common/users/dz323/vlm_tamp
Environment=CUDA_VISIBLE_DEVICES=3 MUJOCO_EGL_DEVICE_ID=3
ExecStart=/bin/bash --noprofile --norc -c 'source scripts/server_runtime_env.sh; export PATH="/common/home/dz323/.local/bin:$$PATH"; exec python tools/run_current_closing_checks.py --study /common/users/dz323/vlm_tamp/results/luna-simplified-pipeline-20261031 --wait-for-gpu'
MemoryMax=16G
MemorySwapMax=0
OOMPolicy=kill
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=default.target

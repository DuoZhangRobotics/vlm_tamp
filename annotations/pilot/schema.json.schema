{
  "$defs": {
    "Constraint": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "goal",
            "path",
            "articulation",
            "contact",
            "temporal"
          ],
          "title": "Category",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "entities": {
          "items": {
            "type": "string"
          },
          "title": "Entities",
          "type": "array"
        },
        "stages": {
          "items": {
            "type": "string"
          },
          "title": "Stages",
          "type": "array"
        },
        "scope": {
          "enum": [
            "goal",
            "path",
            "transition"
          ],
          "title": "Scope",
          "type": "string"
        },
        "requirement": {
          "enum": [
            "required",
            "conditional",
            "optional"
          ],
          "title": "Requirement",
          "type": "string"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "parameters": {
          "items": {
            "$ref": "#/$defs/Parameter"
          },
          "title": "Parameters",
          "type": "array"
        },
        "frame_assumption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame Assumption"
        },
        "evidence": {
          "enum": [
            "instruction",
            "observation",
            "oracle_inventory",
            "oracle_geometry",
            "planning_hypothesis"
          ],
          "title": "Evidence",
          "type": "string"
        },
        "verified": {
          "default": false,
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "category",
        "type",
        "entities",
        "scope",
        "requirement",
        "evidence"
      ],
      "title": "Constraint",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "stages": {
          "default": false,
          "title": "Stages",
          "type": "boolean"
        },
        "dependencies": {
          "default": false,
          "title": "Dependencies",
          "type": "boolean"
        },
        "constraints": {
          "default": false,
          "title": "Constraints",
          "type": "boolean"
        },
        "stages_complete": {
          "default": false,
          "title": "Stages Complete",
          "type": "boolean"
        },
        "dependencies_complete": {
          "default": false,
          "title": "Dependencies Complete",
          "type": "boolean"
        },
        "constraints_complete": {
          "default": false,
          "title": "Constraints Complete",
          "type": "boolean"
        },
        "constraint_categories": {
          "items": {
            "type": "string"
          },
          "title": "Constraint Categories",
          "type": "array"
        }
      },
      "title": "Coverage",
      "type": "object"
    },
    "Dependency": {
      "additionalProperties": false,
      "properties": {
        "before": {
          "title": "Before",
          "type": "string"
        },
        "after": {
          "title": "After",
          "type": "string"
        },
        "requirement": {
          "default": "conditional",
          "enum": [
            "required",
            "conditional",
            "optional"
          ],
          "title": "Requirement",
          "type": "string"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "evidence": {
          "default": "planning_hypothesis",
          "enum": [
            "instruction",
            "observation",
            "oracle_inventory",
            "oracle_geometry",
            "planning_hypothesis"
          ],
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "title": "Dependency",
      "type": "object"
    },
    "Parameter": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "status": {
          "default": "unresolved",
          "enum": [
            "known",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        },
        "frame": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frame"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        },
        "evidence": {
          "default": "planning_hypothesis",
          "enum": [
            "instruction",
            "observation",
            "oracle_inventory",
            "oracle_geometry",
            "planning_hypothesis"
          ],
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Parameter",
      "type": "object"
    },
    "Predicate": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "arguments": {
          "items": {
            "type": "string"
          },
          "title": "Arguments",
          "type": "array"
        }
      },
      "required": [
        "name",
        "arguments"
      ],
      "title": "Predicate",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "official_benchmark",
            "simulator",
            "derived_rule",
            "human"
          ],
          "title": "Source",
          "type": "string"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        }
      },
      "required": [
        "source",
        "evidence"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ReferencePlan": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/Stage"
          },
          "title": "Stages",
          "type": "array"
        },
        "dependencies": {
          "items": {
            "$ref": "#/$defs/Dependency"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/Constraint"
          },
          "title": "Constraints",
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "title": "ReferencePlan",
      "type": "object"
    },
    "Stage": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "entities": {
          "items": {
            "type": "string"
          },
          "title": "Entities",
          "type": "array"
        },
        "subgoals": {
          "items": {
            "$ref": "#/$defs/Predicate"
          },
          "title": "Subgoals",
          "type": "array"
        },
        "requirement": {
          "default": "optional",
          "enum": [
            "required",
            "conditional",
            "optional"
          ],
          "title": "Requirement",
          "type": "string"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "evidence": {
          "default": "planning_hypothesis",
          "enum": [
            "instruction",
            "observation",
            "oracle_inventory",
            "oracle_geometry",
            "planning_hypothesis"
          ],
          "title": "Evidence",
          "type": "string"
        }
      },
      "required": [
        "id",
        "action"
      ],
      "title": "Stage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "example_id": {
      "title": "Example Id",
      "type": "string"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "reviewed"
      ],
      "title": "Status",
      "type": "string"
    },
    "provenance": {
      "items": {
        "$ref": "#/$defs/Provenance"
      },
      "title": "Provenance",
      "type": "array"
    },
    "relevant_entities": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Relevant Entities"
    },
    "manipulable_parts": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manipulable Parts"
    },
    "alternatives": {
      "items": {
        "$ref": "#/$defs/ReferencePlan"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "axis_sign_invariant": {
      "default": true,
      "title": "Axis Sign Invariant",
      "type": "boolean"
    },
    "gaps": {
      "items": {
        "type": "string"
      },
      "title": "Gaps",
      "type": "array"
    }
  },
  "required": [
    "example_id"
  ],
  "title": "ReferenceAnnotation",
  "type": "object"
}